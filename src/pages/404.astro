---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Stránka nenalezena" description="Požadovaná stránka nebyla nalezena." canonicalPath="/404">
  <section class="page-hero container" style="min-height:60vh">
    <p class="eyebrow">Chyba 404</p>
    <h1 class="display">Tady zatím nic postaveného není.</h1>
    <p class="lead">Adresa může být chybná nebo se stránka přestěhovala.</p>
    <p><a class="btn" href="/">Zpět na hlavní stránku</a></p>
  </section>
</BaseLayout>
