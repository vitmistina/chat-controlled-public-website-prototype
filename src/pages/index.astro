---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, services } from '../data/company';
---
<BaseLayout title="Showroom dveří, oken a podlah v Týništi nad Orlicí" description={company.description}>
  <section class="hero">
    <div class="hero__copy">
      <p class="eyebrow">Mostecká 24, Týniště nad Orlicí</p>
      <h1 class="display">Showroom dveří, oken a podlah v Týništi nad Orlicí</h1>
      <p class="lead">Na ploše 500 m² si prohlédnete více než 70 vystavených dveří a setů, okna, podlahy i dveřní kování. Materiály můžete porovnat vedle sebe a vybrat řešení pro konkrétní interiér.</p>
      <div class="hero__actions">
        <a class="btn btn--light" href={company.links.googleMaps} target="_blank" rel="noreferrer">Navigovat do showroomu</a>
        <a class="btn btn--ghost" style="color:white;border-color:white" href={`tel:${company.phoneHref}`}>Zavolat {company.phoneDisplay}</a>
      </div>
    </div>
    <div class="hero__media hero__media--map">
      <iframe
        src={company.links.googleMapsEmbed}
        title="MK Dveře, showroom dveří, oken a podlah v Týništi nad Orlicí"
        loading="eager"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
      <div class="hero__badge">500 m² · přes 70 vystavených dveří a setů</div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <p class="eyebrow">Co najdete v showroomu</p>
      <div class="split" style="align-items:end">
        <h2 class="h2">Dveře, okna, podlahy a kování na jednom místě.</h2>
        <p class="lead">Fotografie a katalog jsou dobrý začátek. Rozhodnutí se ale dělá lépe, když vidíte skutečný dekor, povrch, proporce a návaznost jednotlivých prvků.</p>
      </div>
      <div class="grid grid--2" style="margin-top:3rem">
        {services.map((service, index) => (
          <article class="card service-card">
            <span class="service-card__number">0{index + 1}</span>
            <div>
              <h3>{service.title}</h3>
              <p>{service.lead}</p>
              <p style="margin-top:1rem"><a href={`/sluzby/${service.slug}`}>Zjistit více</a></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="map-card">
        <iframe
          src={company.links.googleMapsEmbed}
          title="Poloha showroomu MK Dveře na mapě"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
      <div>
        <p class="eyebrow">Proč přijet osobně</p>
        <h2 class="h2">Vyberte dveře a podlahu jako jeden interiér, ne jako dvě náhodné objednávky.</h2>
        <p class="lead">V showroomu můžete vedle sebe posoudit dveře, zárubně, kování, podlahy a okna. Přineste rozměry, půdorys nebo fotografie prostoru a zúžíme výběr na smysluplné varianty.</p>
        <div class="stats">
          <div class="stat"><strong>500 m²</strong><span>plocha showroomu</span></div>
          <div class="stat"><strong>70+</strong><span>vystavených dveří a setů</span></div>
          <div class="stat"><strong>1 místo</strong><span>dveře, okna, podlahy a kování</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <p class="eyebrow">Návštěva showroomu</p>
      <h2 class="h2">Jak se připravit, aby návštěva přinesla konkrétní výsledek.</h2>
      <div class="steps" style="margin-top:3rem">
        <article class="step"><h3>Rozměry</h3><p>Přineste základní rozměry otvorů a místností, případně půdorys.</p></article>
        <article class="step"><h3>Fotografie</h3><p>Vyfoťte současný stav, podlahu, stěny a navazující materiály.</p></article>
        <article class="step"><h3>Priority</h3><p>Ujasněte si styl, způsob používání prostoru a přibližný rozpočet.</p></article>
        <article class="step"><h3>Domluva</h3><p>Před cestou zavolejte a ověřte vhodný čas pro konzultaci.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container split">
      <div>
        <p class="eyebrow">Showroom v regionu</p>
        <h2 class="h2">Pohodlně dostupný z Týniště, Kostelce, Rychnova i Hradce Králové.</h2>
      </div>
      <div>
        <p class="lead">Showroom MK Dveře najdete na adrese Mostecká 24 v Týništi nad Orlicí. Na jednom místě můžete porovnat dveře, okna, podlahy a kování pro byt, rodinný dům i rekonstrukci.</p>
        <p><a href={company.links.firmy} target="_blank" rel="noreferrer">Prohlédnout profil a fotografie na Firmy.cz</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container contact-panel split">
      <div>
        <p class="eyebrow" style="color:#f4a06e">Plánujete dveře, okna nebo podlahu?</p>
        <h2 class="h2">Domluvte si návštěvu showroomu MK Dveře.</h2>
      </div>
      <div>
        <p class="lead">{company.visitNote}</p>
        <p><a class="btn btn--light" href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
