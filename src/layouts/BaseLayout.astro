---
import '../styles/global.css';
import '../styles/mk-dvere.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/images/showroom-interior.jpg',
  canonicalPath = Astro.url.pathname,
  jsonLd,
  noindex = false
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
const fullTitle = title === company.name ? title : `${title} | ${company.name}`;
const absoluteImage = new URL(image, Astro.site).toString();

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': ['Store', 'HomeGoodsStore'],
  name: company.name,
  legalName: company.legalName,
  description: company.description,
  url: Astro.site?.toString(),
  telephone: company.phoneHref,
  email: company.email,
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'IČO',
    value: company.ico
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.address.street,
    addressLocality: company.address.city,
    postalCode: company.address.postalCode,
    addressCountry: company.address.country
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.geo.latitude,
    longitude: company.geo.longitude
  },
  hasMap: company.links.googleMaps,
  sameAs: [company.links.googleMaps, company.links.firmy],
  areaServed: company.areaServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
  image: absoluteImage
};

const schemas = jsonLd ? [localBusiness, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : [localBusiness];
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#174c38" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schemas)}></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
