---
import { company } from '../data/company';

const nav = [
  ['Dveře, okna a podlahy', '/sluzby'],
  ['Showroom', '/showroom'],
  ['Kontakt', '/kontakt']
];
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label={`${company.name}, domů`}>
      <span class="brand__mark" aria-hidden="true">MK</span>
      <span class="brand__text">MK DVEŘE <span>OKNA · PODLAHY · KOVÁNÍ</span></span>
    </a>
    <nav class="nav__links" aria-label="Hlavní navigace">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
      <a class="btn" href={`tel:${company.phoneHref}`}>Zavolat</a>
    </nav>
    <details>
      <summary>Menu</summary>
      <nav class="mobile-menu" aria-label="Mobilní navigace">
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        <a href={`tel:${company.phoneHref}`}>{company.phoneDisplay}</a>
      </nav>
    </details>
  </div>
</header>
