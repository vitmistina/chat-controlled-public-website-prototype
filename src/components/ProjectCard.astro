---
interface Props {
  slug: string;
  title: string;
  description: string;
  location: string;
  image: string;
  alt: string;
}
const { slug, title, description, location, image, alt } = Astro.props;
---
<article class="card">
  <a href={`/realizace/${slug}`} aria-label={`Realizace: ${title}`}><img src={image} alt={alt} loading="lazy" width="800" height="600" referrerpolicy="no-referrer" /></a>
  <div class="card__body">
    <p class="eyebrow">{location}</p>
    <h3><a href={`/realizace/${slug}`}>{title}</a></h3>
    <p>{description}</p>
  </div>
</article>
